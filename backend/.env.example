# ---------- OpenRouter ----------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model used for answer generation
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Optional: cheaper/faster model for the routing step (falls back to the chat model)
OPENROUTER_ROUTER_MODEL=
# Embedding model served through OpenRouter (must match EMBEDDING_DIMENSION)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ---------- Pinecone ----------
PINECONE_API_KEY=pcsk_xxxxxxxx
PINECONE_INDEX_NAME=rag-router-agent
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Tavily ----------
TAVILY_API_KEY=tvly-xxxxxxxx
TAVILY_MAX_RESULTS=5

# ---------- RAG tuning ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a chunk to count as "found in the PDF"
RETRIEVAL_MIN_SCORE=0.30
MAX_HISTORY_MESSAGES=10
MAX_UPLOAD_MB=25

# ---------- Server ----------
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=RAG Router Agent
DATA_DIR=data
